# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phongtro_db
DB_USERNAME=postgres
DB_PASSWORD=Yao

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
# Key must be at least 256-bit (32 bytes) string or base64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000          # 24 hours (Access Token)
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days (Refresh Token)

# AI Service Configuration (FastAPI Python)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=5

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# VNPT eKYC Configuration (VNPT AI Platform)
VNPT_EKYC_BASE_URL=https://ekyc.vnpt.vn
VNPT_EKYC_ACCESS_TOKEN=your_vnpt_access_token_here
VNPT_EKYC_TOKEN_ID=your_vnpt_token_id_here
VNPT_EKYC_TOKEN_KEY=your_vnpt_token_key_here
VNPT_EKYC_OCR_URL=https://ekyc.vnpt.vn/ai/v1/ocr/id
VNPT_EKYC_FACEMATCH_URL=https://ekyc.vnpt.vn/ai/v1/face/compare
VNPT_EKYC_CONFIDENCE_THRESHOLD=85.0
VNPT_EKYC_MOCK_ENABLED=false

# VNPAY sandbox: set secret locally and register public IPN URL with VNPAY
VNPAY_TMN_CODE=3IINFGVH
VNPAY_HASH_SECRET=WTOSVCYHASPSQISXRDDFQPYZWROSCCZT
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=https://YOUR-PUBLIC-BACKEND/api/payments/vnpay/ipn

# Backend-to-VNPAY query API (works without public IPN)
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERY_IP=127.0.0.1

# VNPT SmartCA Configuration (Remote Signing API)
VNPT_SMARTCA_BASE_URL=https://rmgateway.vnptit.vn/sca/sp769
VNPT_SMARTCA_AUTH_URL=https://rmgateway-mobile.vnptit.vn/auth/token
VNPT_SMARTCA_PARTNER_INIT_URL=https://rmgateway.vnptit.vn/vi/thirdpartyapi/sdk/partner_init
VNPT_SMARTCA_CLIENT_ID=your_client_id_here
VNPT_SMARTCA_CLIENT_SECRET=your_client_secret_here
VNPT_SMARTCA_SP_ID=your_sp_id_here
VNPT_SMARTCA_SP_PASSWORD=your_sp_password_here
VNPT_SMARTCA_SANDBOX_MODE=true
